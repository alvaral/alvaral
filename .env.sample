# Local site URL. In production, set this to https://www.alvaral.dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public project settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy alias also supported by the app. Use this only if your Supabase
# dashboard still labels the public key as anon.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
